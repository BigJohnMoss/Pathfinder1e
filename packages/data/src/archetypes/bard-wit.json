{
  "id": "bard-wit",
  "name": "Wit",
  "classId": "bard",
  "summary": "The wit is a master of clever repartee and verbal dueling, moving through noble courts like a fish through water.",
  "replacesText": "Bardic Knowledge; Inspire Competence; Dirge of Doom; Frightening Tune; Versatile Performance; Lore Master; Jack-of-All-Trades",
