                "bonus": 0,
                "description": "Mind-affecting, language-dependent magical nonlethal damage within 30 feet; damage reduction applies.",
                "defaultRounds": 1,
                "additionalEffectsByLevel": [
                  {
                    "minimumLevel": 8,
                    "name": "Cutting Remark — Sickened",
                    "target": "enemy",
                    "bonus": 0,
                    "description": "Sickened while within 30 feet and for 1 round thereafter."
                  }
                ]
              },
              "summary": "Spend 1 performance round, roll 1d4 + Bard level nonlethal damage, and track the level-8 sickened rider."
            },
