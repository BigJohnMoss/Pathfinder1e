        {
          "id": "bard-wit-quick-witted-ex-2",
          "name": "Quick Witted (Ex)",
          "level": 2,
          "type": "archetype",
          "summary": "At 2nd level, a wit can always act in a surprise round (though he remains flat-footed until he acts). In addition, the wit adds half his bard level on initiative checks. This ability replaces versatile performance.",
          "progressionProfiles": [
            {
              "id": "wit-surprise-round",
              "label": "Quick Witted surprise round",
              "classId": "bard",
              "columns": [
                {
                  "id": "benefit",
                  "label": "Benefit"
                }
              ],
              "steps": [
                {
                  "level": 2,
                  "values": {
                    "benefit": "Always act in a surprise round; remain flat-footed until acting"
                  }
                }
              ],
              "summary": "The surprise-round permission is always visible alongside the calculated initiative bonus."
            }
          ]
        },
        {
          "id": "bard-wit-on-the-ball-ex-5",
          "name": "On the Ball (Ex)",
          "level": 5,
          "type": "archetype",
          "summary": "At 5th level, rather than roll for initiative, the wit can treat his roll as if it was a 10 (adding any modifiers as usual). The wit can use this ability once per day at 5th level, and an additional time per day for every 6 bard levels thereafter. At 20th level, when the wit uses this ability, he can instead treat his roll as if it was a 20. This ability replaces lore master.",
          "resourceActions": [
            {
              "id": "wit-on-the-ball",
              "label": "Use On the Ball",
              "minimumLevel": 5,
              "classId": "bard",
              "resourceId": "onTheBall",
              "cost": 1,
              "actionTypeByLevel": [
                {
                  "level": 5,
                  "actionType": "standard"
                }
              ],
              "modeLabel": "Skill",
              "modes": [
                {
                  "id": "initiative",
                  "label": "Initiative",
                  "summary": "Replace the initiative d20 roll with the current fixed result."
                }
              ],
              "fixedD20Result": {
                "label": "Natural d20 result",
                "result": 10,
                "resultByLevel": [
                  {
                    "level": 5,
                    "result": 10
                  },
                  {
                    "level": 20,
                    "result": 20
                  }
                ]
              },
              "summary": "Spend one daily use and treat the selected check's natural d20 result as 10."
            }
          ]
        },
        {
          "id": "bard-wit-duel-master-ex-10",
          "name": "Duel Master (Ex)",
          "level": 10,
          "type": "archetype",
          "summary": "At 10th level, the wit does not lose any edges for being at an extreme disadvantage in a verbal duel and can either ask about one additional bias when successfully using Sense Motive to determine an audience’s biases or automatically seed one of the biases that he discovered. Once during a verbal duel, he can reassign an appropriate skill from one tactic to another tactic in which he didn’t assign any skills. The original tactic is treated as being unprepared for the rest of the duel. This ability replaces jack-of-all-trades.",
          "progressionProfiles": [
            {
              "id": "wit-duel-master-rules",
              "label": "Duel Master",
              "classId": "bard",
              "columns": [
                {
                  "id": "benefit",
                  "label": "Verbal-duel benefit"
                }
              ],
              "steps": [
                {
                  "level": 10,
                  "values": {
                    "benefit": "Ignore extreme-disadvantage edge loss; discover/seed one extra bias; reassign one tactic skill once per duel"
                  }
                }
              ],
              "summary": "All passive Duel Master permissions are recorded."
            }
          ],
          "resourceActions": [
            {
              "id": "wit-duel-master-reassignment",
              "label": "Record Duel Master Reassignment",
              "minimumLevel": 10,
              "classId": "bard",
              "actionTypeByLevel": [
                {
                  "level": 10,
                  "actionType": "free"
                }
              ],
              "confirmations": [
                {
                  "id": "verbal-duel",
                  "label": "A verbal duel is in progress and this is the once-per-duel reassignment",
                  "requiredForActivation": true
                }
              ],
              "activeEffect": {
                "name": "Duel Master Reassignment Used",
                "targets": [
                  "self"
                ],
                "bonus": 0,
                "description": "One appropriate skill was reassigned to an unassigned tactic; the original tactic is unprepared for the rest of this verbal duel.",
                "defaultRounds": 999,
                "fixedRounds": true,
                "replaceExisting": true
              },
              "summary": "Track the single skill reassignment allowed in each verbal duel."
            }
          ]
        }
      ]
    }
