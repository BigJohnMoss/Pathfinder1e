{
  "id": "oracle-planar-oracle",
  "name": "Planar Oracle",
  "classId": "oracle",
  "summary": "A planar oracle has an affinity with one of the Outer Planes.",
  "replacesText": "Mystery Bonus Spells; 3rd-level Revelation; Final Revelation",
  "replacements": [
    {
      "featureIds": [
        "oracle-revelation-3",
        "oracle-final-revelation-20"
      ],
      "features": [
        {
          "id": "oracle-planar-oracle-recommended-mysteries-1",
          "name": "Recommended Mysteries",
          "level": 1,
          "type": "archetype",
          "summary": "dark tapestry, flame, heavens, stone, waves, wind."
        },
        {
          "id": "oracle-planar-oracle-bonus-spells-1",
          "name": "Bonus Spells",
          "level": 1,
          "type": "archetype",
          "summary": "endure elements (2nd), elemental speech (4th), tongues (6th), planar adaptation (8th), plane shift (10th), mass planar adaptation (12th), shadow walk (14th), etherealness (16th), gate (18th). These bonus spells replace the oracle’s mystery bonus spells at these levels."
        },
        {
          "id": "oracle-planar-oracle-revelations-1",
          "name": "Planar Affinity",
          "level": 1,
          "type": "selectable",
          "choiceRequired": true,
          "optionGroupId": "planar-oracle-energies",
          "summary": "Choose one Outer Plane at 1st level and keep that affinity. Select an energy type associated with your plane."
        },
        {
          "id": "oracle-planar-oracle-planar-resistance-3",
          "name": "Planar Resistance (Su)",
          "level": 3,
          "type": "archetype",
          "summary": "Reduce damage from the energy type you associated with your plane by 10. At 11th oracle level the resistance increases to 20."
        },
        {
          "id": "oracle-planar-oracle-final-revelation-20",
          "name": "Final Revelation",
          "level": 20,
          "type": "archetype",
          "summary": "At 20th level, take on the appearance of a native of an Outer Plane. You count as a native outsider on your associated plane and as an extraplanar outsider elsewhere, while keeping your existing class statistics and rules for returning from death. Your Planar Resistance becomes immunity and you gain damage reduction 10/magic. This replaces the final revelation of the oracle’s mystery."
        }
      ]
    }
  ],
