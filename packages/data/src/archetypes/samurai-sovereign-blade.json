          "id": "samurai-sovereign-blade-alignment-1",
          "name": "Alignment",
          "level": 1,
          "type": "archetype",
          "summary": "A sovereign blade’s alignment must be at least partially neutral. If the sovereign blade’s alignment is not partially neutral, she is treated as if she had violated her order’s edicts each day until her alignment is again partially neutral.",
          "requiredOptionMessage": "Sovereign Blade requires an alignment with at least one neutral component; otherwise the order's edicts are treated as violated each day."
        },
        {
          "id": "samurai-sovereign-blade-dogmatic-denial-ex-1",
          "name": "Dogmatic Denial (Ex)",
          "level": 1,
          "type": "archetype",
          "summary": "A sovereign blade gains a +2 bonus on saving throws against spells with any of the following descriptors that don’t match part of the character’s own alignment: chaotic, evil, good, or lawful. This ability replaces mount."
