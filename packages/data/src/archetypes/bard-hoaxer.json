        {
          "id": "bard-hoaxer-misery-ex-2",
          "name": "Misery (Ex)",
          "level": 2,
          "type": "archetype",
          "summary": "At 2nd level, a hoaxer learns to take joy in the misfortune of others. He gains a +1 morale bonus on attack rolls and damage rolls against creatures suffering from a curse, hex, or harmful mind-affecting effect, as well as a +1 morale bonus on Will saving throws against spells from such creatures. These bonuses increase by 1 at 5th level and every 6 bard levels thereafter. This ability replaces versatile performance."
        },
