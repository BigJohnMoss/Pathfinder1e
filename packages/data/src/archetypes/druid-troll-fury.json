        {
          "id": "druid-troll-fury-troll-fury-s-mark-su-9",
          "name": "Troll Fury’s Mark (Su)",
          "level": 9,
          "type": "archetype",
          "summary": "At 9th level, each time a troll fury or her animal companion damages a creature with a natural attack, the troll fury gains a +10 insight bonus on Survival checks to track that creature for 24 hours. The duration of this ability does not stack with itself. Each time the troll fury or her animal companion hits the target, this ability lasts for the next 24 hours. This ability replaces venom immunity.",
          "resourceActions": [
            {
              "id": "troll-fury-mark-target",
              "label": "Apply Troll Fury’s Mark",
              "classId": "druid",
              "minimumLevel": 9,
              "confirmations": [
                {
                  "id": "natural-hit",
                  "label": "The Troll Fury or animal companion damaged the target with a natural attack",
                  "requiredForActivation": true
                }
              ],
              "activeEffect": {
                "name": "Troll Fury’s Mark",
                "targets": [
                  "skillChecks"
                ],
                "bonus": 10,
                "description": "+10 insight bonus on Survival checks to track the damaged creature. A new qualifying hit refreshes, rather than stacks, the 24-hour duration.",
                "defaultRounds": 14400,
                "fixedRounds": true,
                "replaceExisting": true,
                "skillOptions": [
                  "Survival"
                ]
              },
              "summary": "Track the marked creature and exact 24-hour duration; reapply after another natural-attack hit to refresh it."
            }
          ]
        }
