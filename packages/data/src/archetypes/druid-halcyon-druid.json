        {
          "id": "druid-halcyon-druid-spontaneous-casting-1",
          "name": "Spontaneous Casting",
          "level": 1,
          "type": "selectable",
          "summary": "A halcyon druid adds all spells from the Good cleric domain to her druid spell list, and she can focus stored spell energy into spells from the Good domain that she hasn’t prepared ahead of time. She can lose a prepared spell to cast any spell of the same level or lower from the Good domain. This ability replaces spontaneous casting.",
          "choiceRequired": true,
          "optionGroupId": "cleric-domains",
          "optionChoiceIds": [
