      "features": [
        {
          "id": "druid-ancient-guardian-ancient-arms-1",
          "name": "Ancient Arms",
          "level": 1,
          "type": "archetype",
          "summary": "An ancient guardian can’t wield weapons made primarily of metal. She is proficient with only the club, dart, quarterstaff, shortspear, sling, and spear. She is also proficient with all natural attacks (claw, bite, and so forth) of any form she assumes with wild shape. Using a prohibited weapon renders her unable to cast druid spells or use any of her druid supernatural or spell-like class abilities while wielding the weapon and for 24 hours after ceasing to wield it. This alters the druid’s normal weapon proficiencies.",
          "resourceActions": [
            {
              "id": "ancient-guardian-prohibited-weapon",
              "label": "Record Prohibited Metal Weapon",
              "classId": "druid",
              "minimumLevel": 1,
              "actionTypeByLevel": [
                {
                  "level": 1,
                  "actionType": "free"
                }
              ],
              "confirmations": [
                {
                  "id": "metal-weapon",
                  "label": "The wielded weapon is made primarily of metal",
                  "requiredForActivation": true
                }
              ],
              "activeEffect": {
                "name": "Ancient Arms Suppression",
                "targets": [
                  "self"
                ],
                "bonus": 0,
                "description": "Druid spells and supernatural and spell-like Druid class abilities are unavailable while the prohibited weapon is wielded and for 24 hours afterward.",
                "defaultRounds": 14400,
                "fixedRounds": true,
                "replaceExisting": true
              },
              "summary": "Start or restart the 24-hour Ancient Arms suppression tracker."
            }
          ]
        },
