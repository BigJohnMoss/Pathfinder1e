        {
          "id": "druid-ancient-guardian-ancient-ways-ex-3",
          "name": "Ancient Ways (Ex)",
          "level": 3,
          "type": "archetype",
          "summary": "At 3rd level, an ancient guardian increases any climb, fly, or swim speeds she has or gains via her wild shape ability by 10 feet. This ability replaces trackless step and woodland stride.",
