{
  "id": "druid-ancient-guardian",
  "name": "Ancient Guardian",
  "classId": "druid",
  "summary": "Ancient guardians revere nature and draw power from its divine energies, but also protect the customs, histories, and lore of their tribe and race.",
  "replacesText": "Weapon Proficiencies; Nature Bond; Wild Empathy; Trackless Step; Woodland Stride; Spontaneous Casting; Resist Nature’s Lure; A Thousand Faces",
