{
  "name": "pathfinder1e-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "validate": "node tools/scripts/validate-data.mjs",
    "pretest": "npm run generate:icons && npm run build:data",
    "test": "node --test tests/*.test.mjs",
    "pretest:ui": "npm run build:data",
    "test:ui": "cross-env NODE_ENV=test TSX_TSCONFIG_PATH=tests/tsconfig.json node --import ./tests/preload-catalogues.mjs --import tsx --test --test-concurrency=1 tests/*ui.test.tsx",
    "test:e2e": "playwright test",
    "build:data": "node tools/scripts/build-data.mjs",
    "import:feat-details": "node tools/scripts/import-feat-details.mjs --all",
    "import:spell-details": "node tools/scripts/import-spell-details.mjs",
    "import:archetypes": "node tools/scripts/import-archetypes.mjs",
    "import:magus-arcana": "node tools/scripts/import-magus-arcana.mjs",
    "import:psychic-options": "node tools/scripts/import-psychic-options.mjs",
    "coverage:archetypes": "node tools/scripts/annotate-archetype-coverage.mjs",
    "coverage": "npm run build:data && node tools/scripts/generate-coverage-report.mjs",
    "coverage:check": "node tools/scripts/generate-coverage-report.mjs --check",
    "performance:check": "node tools/scripts/check-client-budgets.mjs",
    "generate:icons": "node tools/scripts/generate-app-icons.mjs",
    "check": "npm run validate && npm test && npm run test:ui && npm run build:data && npm run coverage:check",
    "dev": "npm --workspace @pf1e/web run dev",
    "prebuild": "npm run generate:icons",
    "build": "npm run build:data && npm --workspace @pf1e/web run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=20"
  }
}
